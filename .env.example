# ============================================
#  JARVIS - Variables de entorno
#  Copia este archivo como .env y rellena tus claves
# ============================================

# --- SPOTIFY ---
# 1. Ve a https://developer.spotify.com/dashboard
# 2. Crea una app, copia Client ID y Client Secret
# 3. En la app, anade Redirect URI: http://localhost:8888/callback
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# --- NOTION ---
# 1. Ve a https://www.notion.so/my-integrations
# 2. Crea una integracion, copia el token
# 3. Comparte tu base de datos de calendario con la integracion
# 4. Copia el ID de la base de datos (esta en la URL)
NOTION_TOKEN=secret_tu_token_aqui
NOTION_CALENDAR_DB=id_de_tu_base_de_datos

# --- CLIMA ---
WEATHER_CITY=Madrid

# --- SENSIBILIDAD PALMAS ---
CLAP_THRESHOLD=3000
CLAP_INTERVAL=0.6
